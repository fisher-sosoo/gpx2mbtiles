# ===== 必填（部署时修改） =====
# 瓦片 URL 模板：Windy “Outdoor map”户外图层（provider: Seznam.cz）
# 实测瓦片覆盖 z0–z19；Windy 网页端地图 minZoom=3 / maxZoom=16
# 注意：tiles.windy.com/tiles/v9.0/all 返回 1x1 占位假图，不可用
TILE_URL_TEMPLATE=https://tiles.windy.com/v1/maptiles/outdoor/256/{z}/{x}/{y}/?lang=en
# 代理地址（海外节点访问瓦片源建议配置；留空则直连）
TILE_PROXY=
# UA 伪装与来源页
TILE_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1
TILE_REFERER=https://www.windy.com/

# ===== 可选（有默认值） =====
DATA_DIR=./data
MAX_CONCURRENCY=8
REQUEST_INTERVAL_MS=100
TILE_TIMEOUT_SECONDS=30
RETRY_MAX=3
RETRY_BACKOFF_BASE=0.5
# 403/429 封禁检测：暂停秒数 / 判定失败次数 / 失败占比 / 连续失败次数
BLOCK_PAUSE_SECONDS=30
BLOCK_FAIL_MIN_COUNT=15
BLOCK_FAIL_RATIO=0.25
BLOCK_CONSECUTIVE_THRESHOLD=6
# 任务最大运行秒数（60 分钟）
TASK_TIMEOUT_SECONDS=3600
# 成品文件过期秒数（3 天）
FILE_EXPIRY_SECONDS=259200
CLEANUP_INTERVAL_SECONDS=60
# 同时运行任务上限
MAX_RUNNING_TASKS=2
# 单任务瓦片数上限
MAX_TILES_PER_TASK=60000
# 缩放与缓冲边界
ZOOM_MIN_CAP=3
ZOOM_MAX_CAP=18
BUFFER_MIN_METERS=0
BUFFER_MAX_METERS=10000
MAX_GPX_BYTES=52428800
# 任务开始前要求的最低剩余磁盘字节（默认 100MB）
DISK_MIN_FREE_BYTES=104857600
# 可选：设置后所有 /api/* 接口要求 X-API-Key 鉴权（个人自用建议设置）
AUTH_TOKEN=
# ===== Garmin 活动长图（可选） =====
# 开关；关掉时 /api/garmin/* 返回 404
GARMIN_ENABLED=1
# 令牌目录（容器里由 docker-compose 挂载到 ./garmin_tokens）
GARMINTOKENS=/app/garmin_tokens
# 使用 Garmin Connect 中国站时设为 true
GARMIN_IS_CN=false
# 活动列表默认时间窗（天）与单次拉取条数上限
GARMIN_DAYS_DEFAULT=30
GARMIN_ACTIVITY_LIMIT=50
# FIT 与解析结果缓存上限（MB），超出按最近使用淘汰
GARMIN_CACHE_MAX_MB=512
# 访问 Garmin 的代理；留空则复用 TILE_PROXY。
# 容器没有直连出口时必须设置（否则表现为 DNS 解析失败 + 长时间挂起）
GARMIN_PROXY=
# 可选：令牌失效后自动用账号密码重登（默认关闭，等于在服务器上留长期凭据）
GARMIN_AUTO_RELOGIN=0
GARMIN_EMAIL=
GARMIN_PASSWORD=
# 两次拉取的最小间隔（秒）：防止把 Garmin 惹毛
GARMIN_MIN_INTERVAL_SECONDS=1
# 注意：Garmin 接口强制要求 AUTH_TOKEN，为空时直接 403
